From 3cd6e83e4df0e6ffebc5bcb0d905d222c9001ed4 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark@ramonaoptics.com>
Date: Sun, 2 Aug 2026 20:34:37 -0400
Subject: [PATCH] Also search the environment prefix include dir when embedding
 MPS Metal shader headers

The inductor MPS backend JIT-compiles Metal shaders at runtime. Both entry
points embed the c10/metal headers into the shader source before compilation
via _embed_headers (torch.mps.compile_shader and
torch/_inductor/codegen/mps.py), resolving `#include <c10/metal/*.h>` by reading
the files from $SP_DIR/torch/include. Any include not found there is left
untouched and later fails at Metal compile time with
"'c10/metal/utils.h' file not found".

In the conda-forge layout the c10 headers live in $PREFIX/include, not
$SP_DIR/torch/include, so every torch.compile targeting the MPS backend fails.
Mirror the approach already taken for the C++ include paths in
0006-use-our-own-PREFIX-for-include-paths-etc.patch and also search
sysconfig.get_config_var("prefix") + "/include" when embedding, so the headers
are found in either layout.
---
 torch/_inductor/codegen/mps.py | 6 +++++-
 torch/mps/__init__.py          | 7 ++++++-
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/torch/_inductor/codegen/mps.py b/torch/_inductor/codegen/mps.py
index f35f4cb..08f48fd 100644
--- a/torch/_inductor/codegen/mps.py
+++ b/torch/_inductor/codegen/mps.py
@@ -6,6 +6,7 @@ import functools
 import itertools
 import logging
 import math
+import sysconfig
 from pathlib import Path
 from typing import Any, TYPE_CHECKING
 
@@ -965,7 +966,10 @@ class MetalKernel(SIMDKernel):
                 ]
                 header_contents = _embed_headers(
                     headers,
-                    [Path(__file__).parent.parent.parent / "include"],
+                    [
+                        Path(__file__).parent.parent.parent / "include",
+                        Path(sysconfig.get_config_var("prefix")) / "include",
+                    ],
                     OrderedSet(),  # type: ignore[arg-type]
                 )
                 code.writeline(header_contents)
diff --git a/torch/mps/__init__.py b/torch/mps/__init__.py
index 8b98d34..d4bdb63 100644
--- a/torch/mps/__init__.py
+++ b/torch/mps/__init__.py
@@ -149,6 +149,8 @@ def compile_shader(source: str):
         >>> x = torch.zeros(16, device="mps")
         >>> lib.full(x, 3.14)
     """
+    import sysconfig
+
     from pathlib import Path
 
     from torch.utils._cpp_embed_headers import _embed_headers
@@ -157,7 +159,10 @@ def compile_shader(source: str):
         raise RuntimeError("MPS is not available")
     source = _embed_headers(
         [l + "\n" for l in source.split("\n")],
-        [Path(__file__).parent.parent / "include"],
+        [
+            Path(__file__).parent.parent / "include",
+            Path(sysconfig.get_config_var("prefix")) / "include",
+        ],
         set(),
     )
     return torch._C._mps_compileShader(source)
-- 
