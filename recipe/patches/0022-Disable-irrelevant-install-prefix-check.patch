From b6e502e51898ad03ca67aea7790e8458b8e9fe6e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20G=C3=B3rny?= <mgorny@quansight.com>
Date: Thu, 29 Oct 2026 16:36:21 +0100
Subject: [PATCH 22/22] Disable irrelevant install prefix check
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Michał Górny <mgorny@quansight.com>
---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9a8945bfebe..d693f4b1987 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -113,7 +113,7 @@ find_package(Python COMPONENTS Interpreter REQUIRED)
 # rpath and torch/__init__.py resolves bin/ and lib/ off its own __file__, so
 # the prefix has to be the torch package directory. Enforce it rather than let
 # a mismatch produce an install that only fails at import time.
-if(SKBUILD)
+if(FALSE)
   get_filename_component(_torch_pkg_dir "${SKBUILD_PLATLIB_DIR}/torch" ABSOLUTE)
   get_filename_component(_torch_prefix "${CMAKE_INSTALL_PREFIX}" ABSOLUTE)
   if(NOT _torch_pkg_dir STREQUAL _torch_prefix)
