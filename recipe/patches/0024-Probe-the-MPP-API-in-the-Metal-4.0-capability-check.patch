From f0eedb5b257aab4e766c11c659c688c49290fe73 Mon Sep 17 00:00:00 2001
From: Mohammad Sadegh Salehi <sadeghsalehi1997@gmail.com>
Date: Fri, 11 Sep 2026 05:22:24 +0000
Subject: [PATCH] Probe the MPP API in the Metal 4.0 capability check, not just
 the language standard (#195302)

Fixes #194946.

`CAN_COMPILE_METAL_40` gates the Metal 4 attention kernels, but the check compiles a kernel whose only Metal 4 content is a lambda:

```metal
kernel void test(device float* ptr, uint idx [[thread_position_in_grid]]) {
    auto fn = [](float x) { return x + 1.0; };
    ptr[idx] = fn(ptr[idx]);
}
```

That establishes the toolchain accepts `-std=metal4.0`, which is not the capability being gated. Some SDKs accept the language standard while not providing the cooperative-tensor input accessors `MppAttention.h` calls, so the check passes and the build then fails:

```
FAILED: caffe2/aten/src/ATen/Attention_40.air
MppAttention.h:301:23: error: no member named 'get_left_input_cooperative_tensor' in
  'mpp::tensor_ops::matmul2d<{16, 32, 16, false, true, true, 1}, metal::execution_simdgroups<1>>'
```

This probes the accessor instead, mirroring the instantiation the build actually uses.

### Verification

Running the block through cmake on Xcode 26.0.1 with the macOS 26.0 SDK, before and after:

```
unpatched: Metal toolchain supports Metal 4.0
           CAN_COMPILE_METAL=YES CAN_COMPILE_METAL_40=YES     <- then fails to build

patched:   Metal toolchain does not support Metal 4.0
           CAN_COMPILE_METAL=YES CAN_COMPILE_METAL_40=NO      <- Metal 4 kernels skipped
```

`CAN_COMPILE_METAL` is unaffected, so only the Metal 4 kernels are dropped.

### What I could not verify

I have no SDK that provides these accessors, so I have confirmed the probe fails where it should and not that it passes where it should. CI covers that direction. If it were wrong, the symptom would be Metal 4 kernels silently dropped on a good toolchain, so it is worth a maintainer eye on that case.

### Credit and traps

The probe body is due to @qflen in the issue thread, who also independently confirmed the failure on Xcode 26.1 and ruled out two alternatives worth recording: `thread_elements` does not exist in `MetalPerformancePrimitives` on any SDK, and a `<float, float, float>` instantiation is never built, so either would fail everywhere and silently disable the Metal 4 kernels for everyone.

Pull Request resolved: https://github.com/pytorch/pytorch/pull/195302
Approved by: https://github.com/malfet
---
 cmake/Metal.cmake | 24 +++++++++++++++++++++---
 1 file changed, 21 insertions(+), 3 deletions(-)

diff --git a/cmake/Metal.cmake b/cmake/Metal.cmake
index 35ad9b81e24c0..1475fe701be13 100644
--- a/cmake/Metal.cmake
+++ b/cmake/Metal.cmake
@@ -53,11 +53,29 @@ set(BFLOAT_METAL_CODE "
     ptr[idx] += 1;
   }
 ")
-set(LAMBDA_METAL_CODE "
+# Probes what the Metal 4.0 pass actually needs, rather than the language
+# standard alone. Two things drifted apart before: the pass compiles every
+# native/mps/*.metal shader with -std=metal4.0 -mmacos-version-min=26.2, and
+# some SDKs accept that standard while not providing the cooperative-tensor
+# input accessors MppAttention.h calls. A language-only probe then passes and
+# Attention_40.air fails to build.
+#
+# So probe both, with the flags the build uses:
+#   * a lambda returning a deduced type, as Convolution.metal does
+#   * the MPP instantiation from MppAttention.h, half inputs, float accumulator
+set(METAL_40_PROBE_CODE "
+#include <metal_stdlib>
+#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
   kernel void test(device float* ptr,
                    uint idx [[thread_position_in_grid]]) {
     auto fn = [](float x) { return x + 1.0; };
     ptr[idx] = fn(ptr[idx]);
+    constexpr auto desc = mpp::tensor_ops::matmul2d_descriptor(
+        16, 32, 16, false, false, true,
+        mpp::tensor_ops::matmul2d_descriptor::mode::multiply_accumulate);
+    mpp::tensor_ops::matmul2d<desc, metal::execution_simdgroup> gemm_op;
+    auto ct_a = gemm_op.template get_left_input_cooperative_tensor<half, half, float>();
+    ptr[idx] += ct_a[0];
   }
 ")
 if(NOT CAN_COMPILE_METAL_FOUND)
@@ -75,8 +93,8 @@ if(NOT CAN_COMPILE_METAL_FOUND)
         set(CAN_COMPILE_METAL NO CACHE BOOL "Host can compile metal shaders")
     endif()
     if(CAN_COMPILE_METAL)
-        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/lambda_test.metal" "${LAMBDA_METAL_CODE}")
-        execute_process(COMMAND xcrun metal -std=metal4.0 -c lambda_test.metal -o /dev/null
+        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/metal_40_probe.metal" "${METAL_40_PROBE_CODE}")
+        execute_process(COMMAND xcrun metal -std=metal4.0 -mmacos-version-min=26.2 -c metal_40_probe.metal -o /dev/null
                         WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
                         OUTPUT_VARIABLE XCRUN_OUTPUT
                         ERROR_VARIABLE XCRUN_OUTPUT
